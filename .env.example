# Frontend environment variables (Vite)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional global fallback — the publishable key can also be configured per restaurant
VITE_STRIPE_PUBLISHABLE_KEY=

# Use "/" for root deployment, or "/repo-name/" when hosted under a GitHub Pages subpath
VITE_BASE_PATH=/
