{
  "rewrites": [
    { "source": "/r/:token/clyo/prodNoClyoKey.php", "destination": "/api/clyo-products?token=:token&mapped=0" },
    { "source": "/r/:token/clyo/prodClyoKey.php", "destination": "/api/clyo-products?token=:token&mapped=1" },
    { "source": "/r/:token/clyo/prodInfoUpdate_KEY.php", "destination": "/api/clyo-product-link?token=:token&action=link" },
    { "source": "/r/:token/clyo/delierProduit.php", "destination": "/api/clyo-product-link?token=:token&action=unlink" },
    { "source": "/r/:token/clyo/customerListOrder.php", "destination": "/api/clyo-orders?token=:token" },
    { "source": "/r/:token/clyo/updateOrder.php", "destination": "/api/clyo-order-update?token=:token" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
